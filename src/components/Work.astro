---
interface Project {
  name: string;
  type: string;
  link: string;
  delayClass?: string;
}

const projects: Project[] = [
  {
    name: "UniPulse",
    type: "Social · Web Design",
    link: "https://unipulse-app.vercel.app",
    delayClass: "",
  },
  {
    name: "JUT",
    type: "SaaS · Landing Page",
    link: "https://jut-five.vercel.app",
    delayClass: "reveal-delay-1",
  },
  {
    name: "CinExpress",
    type: "Entertainment · Web Design",
    link: "https://cinemaxpress.vercel.app",
    delayClass: "reveal-delay-2",
  },
  {
    name: "Korad Wears",
    type: "Fashion · Brand + Web",
    link: "https://korad-wears.vercel.app",
    delayClass: "reveal-delay-1",
  },
  {
    name: "Weather_Pixelz",
    type: "SaaS · Web App",
    link: "https://weather-pixelz.vercel.app",
    delayClass: "reveal-delay-2",
  },
  {
    name: "SolToken",
    type: "Crypto · Web Design",
    link: "https://solanafxdemo.vercel.app",
    delayClass: "reveal-delay-3",
  },
];
---
<section id="work">
  <div class="work-header">
    <h2 class="work-headline reveal">Selected work</h2>
    <span class="work-caption reveal reveal-delay-1">Most of which live.</span>
  </div>

  <div class="work-grid">
    {projects.map((project) => (
      <div class={`work-item reveal ${project.delayClass || ''}`.trim()}>
        <div class="work-item-bg">
          <svg class="work-item-inner-mark" width="60" height="60" viewBox="0 0 44 44" fill="none">
            <rect x="4" y="8" width="18" height="28" rx="3" fill="none" stroke="currentColor" stroke-width="1.4" opacity="0.32" />
            <rect x="14" y="16" width="18" height="28" rx="3" fill="none" stroke="currentColor" stroke-width="1.4" />
          </svg>
        </div>
        <div class="work-overlay">
          <p class="work-proj-name">{project.name}</p>
          <p class="work-proj-type">{project.type}</p>
          <a href={project.link} target="_blank" rel="noopener noreferrer" class="work-proj-link">View case →</a>
        </div>
      </div>
    ))}
  </div>

  <p class="work-more reveal">More available on request —</p>
</section>
