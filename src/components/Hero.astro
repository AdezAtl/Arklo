---
---
<section id="hero">
  <!-- animated logo mark -->
  <div class="hero-logo">
    <svg width="220" height="68" viewBox="0 0 220 68" fill="none" xmlns="http://www.w3.org/2000/svg">
      <rect class="mark-stray-1" x="0" y="4" width="6" height="6" rx="1.5" fill="currentColor" opacity="0.07" />
      <rect class="mark-back" x="5" y="12" width="22" height="36" rx="3.5" fill="none" stroke="currentColor" stroke-width="1.5" opacity="0.28" />
      <rect class="mark-front" x="18" y="22" width="22" height="36" rx="3.5" fill="none" stroke="currentColor" stroke-width="1.5" />
      <rect class="mark-stray-2" x="42" y="56" width="5" height="5" rx="1.2" fill="currentColor" opacity="0.08" />
      <text class="mark-wordmark" x="58" y="46" font-family="Inter,sans-serif" font-size="30" font-weight="200" letter-spacing="7" fill="currentColor">ARKLO</text>
    </svg>
  </div>

  <h1 class="hero-headline">
    Websites that<br /><em>change</em> everything.
  </h1>

  <p class="hero-sub">
    Arklo Digital builds fast, custom websites and digital interfaces for startups and boutique brands.
  </p>

  <div class="hero-actions">
    <a class="btn-primary" href="/services">Services &amp; Pricing</a>
    <a class="btn-ghost" href="#work">See our work</a>
  </div>

  <div class="scroll-hint">
    <span>Scroll</span>
    <div class="scroll-line"></div>
  </div>
</section>
