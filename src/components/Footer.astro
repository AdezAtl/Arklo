---
const currentYear = new Date().getFullYear();
---
<footer>
  <div class="footer-left">
    <svg width="90" height="24" viewBox="0 0 90 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <rect x="0" y="2" width="2.5" height="2.5" rx="0.6" fill="currentColor" opacity="0.07" />
      <rect x="2" y="4" width="9" height="15" rx="1.8" fill="none" stroke="currentColor" stroke-width="1" opacity="0.25" />
      <rect x="7" y="8" width="9" height="15" rx="1.8" fill="none" stroke="currentColor" stroke-width="1" opacity="0.7" />
      <text x="20" y="18" font-family="Inter,sans-serif" font-size="11" font-weight="300" letter-spacing="2.5" fill="currentColor" opacity="0.6">ARKLO</text>
    </svg>
    <p class="footer-quote">
      "He changes moment by moment — at one moment the eyes,<br />
      at another the mouth, and so at times the disease,<br />
      most of which live."
    </p>
    <p class="footer-copy">&copy; {currentYear} Arklo Studio. All rights reserved.</p>
  </div>

  <div class="footer-right">
    <ul class="footer-links">
      <li><a href="#about">About</a></li>
      <li><a href="#services">Services</a></li>
      <li><a href="#work">Work</a></li>
      <li><a href="#contact">Contact</a></li>
    </ul>
    <p class="footer-copy">hello@arklo.studio</p>
  </div>
</footer>
